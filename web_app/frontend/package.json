{
  "name": "cnt-production-workbench",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:200})\"",
    "build": "npm run clean && vue-tsc -b && vite build && npm run normalize:dist",
    "normalize:dist": "node -e \"const fs=require('node:fs');const p='dist/index.html';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\\r\\n?/g,'\\n'))\"",
    "generate:types": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/types/openapi.gen.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.2.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.5"
  }
}
