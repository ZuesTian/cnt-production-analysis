cnt-analysis.47.236.76.214.nip.io {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	handle /api/usage/record {
		reverse_proxy 127.0.0.1:8782
	}
	@api path /api/* /health
	handle @api {
		request_body {
			max_size 50MB
		}
		reverse_proxy 127.0.0.1:8768
	}

	handle {
		reverse_proxy 127.0.0.1:8768
	}
}
